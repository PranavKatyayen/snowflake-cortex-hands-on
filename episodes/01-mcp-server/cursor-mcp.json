{
  "mcpServers": {
    "snowbrew": {
      "url": "https://<org>-<account>.snowflakecomputing.com/api/v2/databases/SNOWBREW_LAB/schemas/CORE/mcp-servers/SNOWBREW_MCP",
      "auth": {
        "CLIENT_ID": "<OAUTH_CLIENT_ID from SYSTEM$SHOW_OAUTH_CLIENT_SECRETS('SNOWBREW_MCP_CURSOR')>",
        "CLIENT_SECRET": "${env:SNOWBREW_CURSOR_CLIENT_SECRET}",
        "scopes": ["refresh_token", "session:role:MCP_LAB_ROLE"]
      }
    }
  }
}
